# SmartEVCharge Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartevcharge?retryWrites=true&w=majority

# JWT Secret — use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# OpenChargeMap API Key (get from https://openchargemap.org/site/develop/api)
OCM_API_KEY=your_ocm_api_key_here

# Gmail SMTP credentials (use an App Password — NOT your real Gmail password)
# Enable 2FA on Gmail → App Passwords → Generate for "Mail"
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password_here
