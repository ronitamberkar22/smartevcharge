# SmartEVCharge Environment Variables
# Copy this file to .env and fill in your values

# OpenChargeMap API Key (get from https://openchargemap.org/site/develop/api)
OCM_API_KEY=your_ocm_api_key_here

# Gmail SMTP credentials (use an App Password, not your real password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password_here

# Server port
PORT=3001
